# Valores de exemplo para testes locais com docker compose.
# Na raiz do projeto, copie este arquivo: Copy-Item .env.example .env
# Para gerar credenciais aleatorias, execute .\setup-local.ps1 sem um .env existente.
# As credenciais abaixo sao publicas e servem apenas para desenvolvimento local.

POSTGRES_PASSWORD=togglemaster_local_123
MASTER_KEY=togglemaster-master-local
SERVICE_API_KEY=tm_key_togglemaster_local_testes

# SHA-256 de SERVICE_API_KEY em UTF-8, sem quebra de linha.
# Se alterar SERVICE_API_KEY, recalcule este hash para a autenticacao funcionar.
SERVICE_API_KEY_SHA256=ca293beb4d92a8acb1e459ec007419e98451e1e1c502918c34d4a3d81c3e5b00
