# Configuracao exclusiva dos testes AWS. Nao usa o .env de Teste API.
API_URL=http://k8s-nginxing-nginxing-7a181552d3-5aac9eb22cb916b5.elb.us-east-1.amazonaws.com
API_HOST=togglemaster.local
API_KEY=
MASTER_KEY=
NOME_FLAG=update-user
HTTP_TIMEOUT=10

# Vazio: usa a cadeia padrao de credenciais do boto3 / seu aws configure.
# Nao copie access keys para este arquivo.
AWS_PROFILE=
AWS_REGION=us-east-1
EXPECTED_AWS_ACCOUNT_ID=608541039538
AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/608541039538/fiap-evaluation-analytics-queue
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# Usado somente pelas opcoes que consultam/controlam Kubernetes via kubectl.
KUBECTL_CONTEXT=arn:aws:eks:us-east-1:608541039538:cluster/fiap-techchallenge
KUBERNETES_NAMESPACE=togglemaster
KEDA_SCALEDOBJECT=analytics-sqs

# Opcional: consulta SQL somente leitura por um tunel JA estabelecido.
# RDS privado nao e acessivel diretamente pela Internet. O script nao cria tunel.
RDS_HOST=
RDS_PORT=15432
RDS_USER=postgres
RDS_SSLMODE=require
RDS_SSLROOTCERT=
